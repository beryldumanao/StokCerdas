# Opsional. Tanpa dua variabel ini aplikasi berjalan di MODE LOKAL (data di browser).
# Isi keduanya untuk mengaktifkan login dan database Supabase (lihat README bagian "Mengaktifkan Supabase").
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# JANGAN pernah menaruh service-role key di sini atau di variabel NEXT_PUBLIC_*: nilainya terkirim ke browser.
